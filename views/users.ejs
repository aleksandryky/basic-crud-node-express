<%- include('partials/header', { title: 'Users List' }) %>

<div class="dashboard-wrapper">
  <%- include('partials/sidebar', { activePage: 'users' }) %>

  <div class="main-content">
    <h1>Users List</h1>
    <p class="page-subtitle">All registered users in the system.</p>

    <div class="card">
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th>Registered</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof users !== 'undefined' && users.length > 0) { %>
            <% users.forEach(function(u) { %>
              <tr>
                <td><%= u.id %></td>
                <td><%= u.name %></td>
                <td><%= u.email %></td>
                <td><%= u.phone || '—' %></td>
                <td><span class="badge badge-green">Active</span></td>
                <td><%= u.created_at ? new Date(u.created_at).toLocaleDateString() : '—' %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" style="text-align:center;color:#6b7280;padding:2rem;">No users found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

</body>
</html>
